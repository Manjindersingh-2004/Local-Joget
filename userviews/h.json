                        "list-customFooter": "<br/><br/>\nRead <a style=\"color:blue;\" href=\"https://dev.joget.org/community/display/KBv5/Deadlines+and+Escalations\" target=\"_blank\">Joget KB<\/a>",
                        "assignment-customHeader": "",
