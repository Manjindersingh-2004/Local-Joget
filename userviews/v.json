                {
                    "className": "org.joget.plugin.enterprise.DashboardMenu",
                    "properties": {
                        "mode": "plugins",
                        "userviewCacheDuration": "20",
                        "customHeader": "<script>\n  function openPlanPopup() {\n    document.getElementById('buyPlanModal').style.display = 'block';\n  }\n\n  function closePlanPopup() {\n    document.getElementById('buyPlanModal').style.display = 'none';\n  }\n\n  function confirmPurchase() {\n    closePlanPopup();\n    alert('Purchase successful! Policy details will be sent to your email.');\n  }\n<\/script>\n\n<style>\n  body {\n    margin: 0;\n    font-family: 'Segoe UI', sans-serif;\n    background-color: #f4f6f8;\n  }\n\n  .container {\n    max-width: 1200px;\n    margin: 40px auto;\n    padding: 20px;\n    display: flex;\n    gap: 30px;\n  }\n\n  .left-panel {\n    flex: 0 0 350px;\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n  }\n\n  .card {\n    background-color: white;\n    border-radius: 12px;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.08);\n    padding: 20px;\n  }\n\n  .vehicle-info h2 {\n    font-size: 1.5rem;\n    color: #1e3a5f;\n    margin-bottom: 10px;\n  }\n\n  .vehicle-info img {\n    width: 100%;\n    border-radius: 8px;\n    margin-bottom: 15px;\n  }\n\n  .info-line {\n    font-size: 0.95rem;\n    margin-bottom: 8px;\n    color: #555;\n  }\n\n  .quote-section {\n    flex: 1 1 0;\n  }\n\n  .quote-card {\n    background-color: white;\n    border-radius: 12px;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.08);\n    padding: 20px;\n    margin-bottom: 20px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n\n  .quote-left {\n    display: flex;\n    align-items: center;\n    gap: 15px;\n  }\n\n  .quote-left img {\n    width: 40px;\n    height: 40px;\n  }\n\n  .quote-details {\n    font-size: 0.95rem;\n    color: #444;\n  }\n\n  .quote-details strong {\n    color: #1e3a5f;\n  }\n\n  .buy-btn {\n    background-color: #1e88e5;\n    color: white;\n    border: none;\n    padding: 10px 16px;\n    border-radius: 6px;\n    cursor: pointer;\n  }\n\n  .ad-card h3 {\n    margin-bottom: 10px;\n    color: #1e3a5f;\n  }\n\n  .ad-card p {\n    color: #555;\n    font-size: 0.95rem;\n  }\n\n<\/style>\n<div class=\"container\">\n\n  <!-- Left Side -->\n  <div class=\"left-panel\">\n\n    <!-- Vehicle Card -->\n    <div class=\"card vehicle-info\">\n      <h2><i><img src=\"/jw/web/app/insuranceChatbot/resources/car.png\" style=\"width: 24px; vertical-align: middle; margin-right: 5px;\"><\/i> Vehicle Details<\/h2>\n      <div class=\"info-line\"><strong>Model:<\/strong> Maruti Swift LXI<\/div>\n      <div class=\"info-line\"><strong>Fuel:<\/strong> Petrol<\/div>\n      <div class=\"info-line\"><strong>Year:<\/strong> 2021<\/div>\n      <div class=\"info-line\"><strong>Registration:<\/strong> TN22BB1122 <\/div>\n      <div class=\"info-line\"><strong>Location:<\/strong> New Delhi<\/div>\n    <\/div>\n\n    <!-- Ad/Feature Card -->\n    <div class=\"card ad-card\">\n      <h3>📢 Get Notified!<\/h3>\n      <p>Turn on notifications to receive alerts when your insurance is due for renewal. Stay protected without missing deadlines.<\/p>\n    <\/div>\n\n  <\/div>\n\n  <!-- Quotes Section -->\n  <!-- Quotes Section -->\n<div class=\"quote-section\">\n\n  <div class=\"quote-card\">\n    <div class=\"quote-left\">\n      <img src=\"/jw/web/app/insuranceChatbot/resources/car.png\" alt=\"Car Icon\" style=\"width: 32px; height: 32px;\">\n      <div class=\"quote-details\">\n        <div><strong>\u20b94,500 - Comprehensive Plan <\/strong><\/div>\n        <div>IDV: \u20b93,90,000<\/div>\n        <div>Coverage: Own Damage + Third-party<\/div>\n        <div>Claim Settlement: 98.2%<\/div>\n        <div>Cashless Garages: 4700+<\/div>\n        <div>Policy Term: 1 Year<\/div>\n      <\/div>\n    <\/div>\n    <button class=\"buy-now-btn\" onclick=\"openPlanPopup()\">Buy Now<\/button>\n  <\/div>\n\n  <div class=\"quote-card\">  \n    <div class=\"quote-left\">\n      <img src=\"/jw/web/app/insuranceChatbot/resources/car.png\" alt=\"Car Icon\" style=\"width: 32px; height: 32px;\">\n      <div class=\"quote-details\">\n        <div><strong>\u20b94,200 - Basic Plan <\/strong><\/div>\n        <div>IDV: \u20b93,70,000<\/div>\n        <div>Coverage: Third-party + PA Cover<\/div>\n        <div>Claim Settlement: 97.5%<\/div>\n        <div>Cashless Garages: 3900+<\/div>\n        <div>Policy Term: 1 Year<\/div>\n      <\/div>\n    <\/div>\n    <button class=\"buy-now-btn\" onclick=\"openPlanPopup()\">Buy Now<\/button>\n  <\/div>\n\n  <div class=\"quote-card\">\n    <div class=\"quote-left\">\n      <img src=\"/jw/web/app/insuranceChatbot/resources/car.png\" alt=\"Car Icon\" style=\"width: 32px; height: 32px;\">\n      <div class=\"quote-details\">\n        <div><strong>\u20b94,750 - Zero Depreciation<\/strong> <\/div>\n        <div>IDV: \u20b94,00,000<\/div>\n        <div>Coverage: Full + Zero Dep<\/div>\n        <div>Claim Settlement: 99.1%<\/div>\n        <div>Cashless Garages: 5100+<\/div>\n        <div>Policy Term: 1 Year<\/div>\n      <\/div>\n    <\/div>\n    <button class=\"buy-now-btn\" onclick=\"openPlanPopup()\">Buy Now<\/button>\n  <\/div>\n\n<\/div>\n\n\n<\/div>\n\n<!-- Modal for Buy Now -->\n<!-- Modal Popup -->\n<!-- Modal Popup -->\n<div id=\"buyPlanModal\" style=\"display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.4); z-index:999;\">\n  <div style=\"background:white; padding:0; border-radius:12px; width:90%; max-width:500px; margin:100px auto; position:relative; box-shadow:0 8px 16px rgba(0,0,0,0.2); overflow:hidden;\">\n    \n    <!-- Header -->\n    <div style=\"background-color:#1e3a5f; color:white; padding:20px;\">\n      <h2 style=\"margin:0; font-size:1.5rem;\">Confirm Your Plan<\/h2>\n    <\/div>\n\n    <!-- Divider Line -->\n    <div style=\"height: 4px; background: #1e88e5;\"><\/div>\n\n    <!-- Content -->\n    <div style=\"padding: 25px;\">\n      <p>You are about to purchase the <strong>Comprehensive Protection Plan<\/strong> for your vehicle. This plan includes:<\/p>\n      <ul style=\"margin-left: 20px; color: #444;\">\n        <li>Zero Depreciation Cover<\/li>\n        <li>Cashless Garage Network<\/li>\n        <li>Roadside Assistance<\/li>\n        <li>1-Year Coverage<\/li>\n      <\/ul>\n      <p style=\"margin-top: 10px;\">Proceed with payment?<\/p>\n\n      <!-- Buttons -->\n      <div style=\"text-align:right; margin-top: 25px;\">\n        <button onclick=\"closePlanPopup()\" style=\"margin-right:10px; background-color:#ccc; border:none; padding:8px 16px; border-radius:6px; cursor:pointer;\">Cancel<\/button>\n        <button onclick=\"confirmPurchase()\" style=\"background-color:#1e88e5; color:white; border:none; padding:8px 16px; border-radius:6px; cursor:pointer;\">Confirm<\/button>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/div>",
